CREATE TABLE IF NOT EXISTS usuarios (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cargo VARCHAR(50) NOT NULL,
    nivel INTEGER NOT NULL CHECK (nivel BETWEEN 1 AND 3),
    categoria VARCHAR(50) NOT NULL,
    senha VARCHAR(255) NOT NULL,
    data_cadastro TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    "reset" VARCHAR(3) NOT NULL DEFAULT 'nao' CHECK ("reset" IN ('sim', 'nao'))
);

INSERT INTO usuarios (nome, cargo, nivel, categoria, senha, "reset")
SELECT 'Administrador', 'Administrador', 3, 'Administrador', '1234', 'sim'
WHERE NOT EXISTS (SELECT 1 FROM usuarios WHERE nome = 'Administrador');
