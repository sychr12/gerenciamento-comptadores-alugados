    saidamt VARCHAR(80) NOT NULL DEFAULT '',
    "Patrimonio" VARCHAR(100),
    "replacementName" VARCHAR(150) NOT NULL DEFAULT '',
    "replacementModel" VARCHAR(100) NOT NULL DEFAULT '',
    "replacementDate" DATE,
    obs TEXT NOT NULL DEFAULT ''
);

