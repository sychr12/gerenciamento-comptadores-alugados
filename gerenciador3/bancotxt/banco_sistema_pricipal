    ownership VARCHAR(20) NOT NULL DEFAULT 'Alugado',
    "entryDate" DATE,
    "Resp" VARCHAR(150) NOT NULL DEFAULT '',
    "Setor" VARCHAR(120) NOT NULL DEFAULT '',
